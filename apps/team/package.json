{
  "name": "@qarows/team",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:worker": "wrangler dev --config wrangler.toml --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply qarows-v2 --local --config wrangler.toml",
    "preview": "vite preview",
    "check:worker-env": "bash scripts/check-worker-env.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@qarows/application": "*",
    "@qarows/runner-ui": "*",
    "@qarows/shared": "*",
    "@qarows/ui": "*",
    "diff": "^9.0.0",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
