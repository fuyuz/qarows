{
  "name": "@qarows/team",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:worker": "cf dev --port 8787",
    "db:migrate:local": "bash scripts/migrate-local.sh",
    "preview": "vite preview",
    "check:worker-env": "bash scripts/check-worker-env.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@qarows/application": "*",
    "@qarows/runner-ui": "*",
    "@qarows/shared": "*",
    "@qarows/ui": "*",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.17",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
