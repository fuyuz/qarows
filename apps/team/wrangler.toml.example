# https://developers.cloudflare.com/workers/wrangler/configuration/
name = "qarows-v2"
main = "worker/index.ts"
compatibility_date = "2026-06-28"
compatibility_flags = ["nodejs_compat"]

# Copy to wrangler.toml and fill in before deploy:
# account_id = "YOUR_ACCOUNT_ID"

[observability]
enabled = true

[observability.logs]
head_sampling_rate = 1

[observability.traces]
enabled = true
head_sampling_rate = 0.01

[vars]
# Access JWT is always enforced on deployed hosts.
# AUTH_DEV_BYPASS is only honored for local wrangler (localhost/127.0.0.1:8787).
# Zero Trust team name (https://<ACCESS_TEAM_DOMAIN>.cloudflareaccess.com)
ACCESS_TEAM_DOMAIN = "your-team-name"
# Access Application AUD tag — copy from Zero Trust → Access → Application → Overview
# See docs/deploy-v2.md §4.4 (not auto-injected by Cloudflare)
ACCESS_AUD = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Worker-side allow guard (choose Method A or B in Access policy + mirror here):
# Method B — organization domain:
# ACCESS_ALLOWED_EMAIL_DOMAIN = "example.com"
# Method A — named individuals (comma-separated):
# ACCESS_ALLOWED_EMAILS = "alice@example.com,bob@example.com"
#
# Optional: AI-assisted tests.yml editing (UI + API appear when bound)
# [ai]
# binding = "AI"
#
# Prefer json_schema-capable models (see Workers AI JSON Mode docs).
# AI_MODEL = "@cf/openai/gpt-oss-120b"
# AI_MODEL_FALLBACK = "@cf/meta/llama-3.3-70b-instruct-fp8-fast"

[assets]
directory = "./dist"
not_found_handling = "single-page-application"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "qarows-v2"
# After `wrangler d1 create qarows-v2`, set:
# database_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
migrations_dir = "migrations"

# Optional: bug attachments (images/videos stored in R2).
# Create the bucket first: wrangler r2 bucket create qarows-team-attachments
# Remove this block to disable attachments (UI hides the feature).
[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "qarows-team-attachments"

[durable_objects]
bindings = [{ name = "PROJECT", class_name = "ProjectRoom" }]

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ProjectRoom"]
