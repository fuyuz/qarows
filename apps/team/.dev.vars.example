# Copy to .dev.vars for local `cf dev` (bun run dev:team).
AUTH_DEV_BYPASS = "true"
#
# Bypass is honored ONLY for requests to localhost/127.0.0.1:8787 (local dev server).
# Setting AUTH_DEV_BYPASS on a deployed Worker is ignored — Access JWT stays required.
# Do not put AUTH_DEV_BYPASS in cloudflare.config.ts (deploy refuses it).
# ACCESS_TEAM_DOMAIN = "your-team-name"
# ACCESS_AUD = "..."  # required in production — see docs/deploy-team.md §4.4
# Method B: ACCESS_ALLOWED_EMAIL_DOMAIN = "example.com"
# Method A: ACCESS_ALLOWED_EMAILS = "alice@example.com,bob@example.com"
#
# Local dev: optional X-Qarows-User request header, or defaults to dev@local.
